  "query": "\n                SELECT h.id AS host_id, h.url, h.auth_header, hg.id AS host_guild_id, s.key, s.id AS subscription_id\n                FROM host h\n                INNER JOIN host_guild hg ON hg.host_id = h.id\n                INNER JOIN subscription s ON s.host_guild_id = hg.id\n            ",
